# Copy this file to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=gsk_...
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=...

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# HINDSIGHT_BANK_ID=malabar-electronics     # memory bank used by the demo business
# JWT_SECRET=                               # created for you in storage/ if not set
# DEMO_EMAIL=demo@cashwise.app
# DEMO_PASSWORD=demo1234
# SEED_DEMO=true

# Sign in with Google / GitHub / Apple (optional - see BACKEND.md for how to get these)
# APP_URL=http://localhost:5173        # the address you open the app at
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=                     # your Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=C:\Cashwise\AuthKey_XXXX.p8

# Email for reports (optional). Without it, "Open in my email app" still works.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Cashwise <you@gmail.com>
# SMTP_SSL=false
# REPORT_TZ=Asia/Kolkata
# RUN_SCHEDULER=true
